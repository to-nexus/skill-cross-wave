# cross-wave — copy to .env and fill in. NEVER COMMIT THIS FILE.

# REQUIRED for `whoami`, `referral`, `submit`. Auth-required calls need a
# JWT access_token captured from your browser DevTools after logging into
# https://wave.crosstoken.io with your CROSSx wallet. See SKILL.md §3 for
# the capture steps.
#
# Recommended workflow: persist via `node scripts/login.mjs --token <jwt>`
# (writes ~/.claude/skills/cross-wave/.sessions/wave.json mode 0600). For a
# one-shot call without persistence, set this env instead.
# CROSS_WAVE_ACCESS_TOKEN=eyJhbGciOi...

# OPTIONAL — wave back-end API base override (debug only). Without this,
# the registry value at references/wave.json is used.
# CROSS_WAVE_API_BASE=https://wave-client-api.crosstoken.io

# OPTIONAL — submit URL allow-list override (comma-separated host suffixes).
# Default: youtube.com,youtu.be,tiktok.com,vt.tiktok.com
# CROSS_WAVE_SUBMIT_HOSTS=youtube.com,youtu.be,tiktok.com,vt.tiktok.com
